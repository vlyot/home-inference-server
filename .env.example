# Reference only — nothing loads this file automatically. Set these in your
# shell, in deploy/windows/run.cmd, or (for RAILWAY_QUEUE_*) config.json.

# ── cmd/server (local inference server) ──────────────────────────────────────
PORT=8080
# HIS_BIND_ADDR overrides the listen address (default :PORT = all interfaces).
# Set to 127.0.0.1:8080 to restrict to localhost.
HIS_BIND_ADDR=
# When set, non-loopback callers to /v1/* must send X-API-Key: <this>.
# Unset = the local API is unauthenticated (fine on a trusted LAN).
HIS_API_KEY=
# Comma-separated allow-list of browser Origins for CORS. Empty = CORS disabled.
HIS_CORS_ORIGINS=
# Per-request inference deadline (ms) when the caller omits timeout_ms. Default 600000.
HIS_INFER_TIMEOUT_MS=
# llama-server --ctx-size override. WARNING: the roster's KVOverheadMB values are
# tuned for 4096; raising this makes the VRAM fit/eviction math wrong.
HIS_CTX_SIZE=
# Where persisted chat conversations live. Default %LOCALAPPDATA%\home-inference-server\chats
CHATS_DIR=
# Hosted relay: enables the offline-queue worker AND durable deferral under
# pressure. Unset = LAN-only, no deferral.
RAILWAY_QUEUE_URL=
RAILWAY_QUEUE_API_KEY=

# ── cmd/server flags (not env) ──────────────────────────────────────────────
#   --backend=llamacpp   real inference (default; needs the GPU + models)
#   --backend=stub       fake inference for CI / the conformance suite
#   --chats-dir <path>   overrides CHATS_DIR

# ── cmd/testapp ─────────────────────────────────────────────────────────────
HIS_TESTAPP_ADDR=http://localhost:8080
# HIS_TESTAPP_STUB=1 relaxes vision/timeout checks when the target is --backend=stub
HIS_TESTAPP_RELAY_ADDR=
HIS_TESTAPP_RELAY_KEY=

# ── cmd/railway (the hosted relay) — see deploy/railway/queue-api.env.example ─
